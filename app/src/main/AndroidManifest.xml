<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="Blueprint sample theme"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <service
            android:name=".BlueprintThemeService"
            android:exported="true"
            android:process=":theme">
            <intent-filter>
                <action android:name="dev.paperreader.extensions.api.action.PAPER_THEME" />
            </intent-filter>
            <meta-data
                android:name="dev.paperreader.extensions.API_VERSION"
                android:value="1" />
            <meta-data
                android:name="dev.paperreader.extensions.KIND"
                android:value="theme" />
        </service>
    </application>
</manifest>
